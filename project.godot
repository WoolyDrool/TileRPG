; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="TileRPG"
run/main_scene="uid://cfllbnfjjje4u"
config/features=PackedStringArray("4.6", "C#", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Globals="*res://app/globals.gd"
SignalBus="*res://app/signal_bus.gd"
Game="*res://app/game.gd"
PhantomCameraManager="*uid://duq6jhf6unyis"
GlobalUI="*res://ui/global_ui.gd"
Dialogic="*uid://ds2q0uclmolvu"
GUIDE="*uid://daex7o8hw0efa"

[dialogic]

directories/dch_directory={
"Viktor": "res://content/dialogic/characters/Viktor.dch",
"arthur": "res://content/dialogic/characters/arthur.dch",
"brunor": "res://content/dialogic/characters/brunor.dch",
"galahad": "res://content/dialogic/characters/galahad.dch",
"gawain": "res://content/dialogic/characters/gawain.dch",
"lancelot": "res://content/dialogic/characters/lancelot.dch",
"merlin": "res://content/dialogic/characters/merlin.dch",
"merrok": "res://content/dialogic/characters/merrok.dch",
"nimue": "res://content/dialogic/characters/nimue.dch"
}
directories/dtl_directory={
"BrunorSolo": "res://content/dialogic/timelines/BrunorSolo.dtl",
"gawainHandler": "res://content/dialogic/timelines/gawainHandler.dtl",
"gawainTutorial": "res://content/dialogic/timelines/gawainTutorial.dtl",
"glossaryTesting": "res://content/dialogic/timelines/glossaryTesting.dtl",
"introSegment": "res://content/dialogic/timelines/introSegment.dtl",
"journal_selector_testing_timeline": "res://content/dialogic/timelines/testing/journal_selector_testing_timeline.dtl",
"merlinHandler": "res://content/dialogic/timelines/merlinHandler.dtl"
}
layout/style_directory={
"": "res://content/dialogic/ui/tilerpg_dialogic_style.tres",
"tilerpg_dialogic_style": "res://content/dialogic/ui/tilerpg_dialogic_style.tres"
}
layout/style_list=["res://content/dialogic/ui/tilerpg_dialogic_style.tres"]
layout/default_style="res://content/dialogic/ui/tilerpg_dialogic_style.tres"
glossary/default_case_sensitive=false
extensions_folder="res://addons/dialogic_additions"
text/letter_speed=0.01
text/initial_text_reveal_skippable=true
text/text_reveal_skip_delay=0.1
text/advance_delay=0.1
text/autoadvance_per_character_delay=0.1
text/autoadvance_ignored_characters_enabled=true
animations/join_default_length=0.5
animations/join_default_wait=false
animations/leave_default_length=0.5
animations/leave_default_wait=false
animations/cross_fade_default_length=0.5
choices/autofocus_first=true
choices/delay=0.2
choices/reveal_delay=0
choices/reveal_by_input=false
save/autosave_delay=60.0
save/encryption_on_exports_only=true
history/visited_event_history_enabled=false
text/autopauses={}
audio/channel_defaults={
"": {
"audio_bus": "",
"fade_length": 0.0,
"loop": false,
"volume": 0.0
},
"music": {
"audio_bus": "",
"fade_length": 0.0,
"loop": true,
"volume": 0.0
}
}
variables={
"convo_progress": {
"gawain": {
"tutorialSeen": false
},
"merlin": {
"merlinSolved": false
}
}
}
glossary/glossary_files=["uid://ql82xcoxcnyg", "uid://i8wmmt227w8d"]
text/input_action="dialogic_default_action"
glossary/default_color=Color(1, 1, 1, 1)

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="viewport"

[dotnet]

project/assembly_name="tile-rpg"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogic/plugin.cfg", "res://addons/guide/plugin.cfg", "res://addons/phantom_camera/plugin.cfg", "res://addons/sticky_scribe/plugin.cfg")

[file_customization]

folder_colors={
"res://addons/": "gray",
"res://app/": "blue",
"res://content/": "green",
"res://player/": "red",
"res://shaders/": "green",
"res://sound/": "green",
"res://systems/": "purple",
"res://textures/": "green",
"res://ui/": "orange"
}

[global_group]

Tile=""
EntityHealth=""

